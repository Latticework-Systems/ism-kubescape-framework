{
  "name": "ism-non-root-containers",
  "attributes": {
    "ismControls": [
      "ISM-1246",
      "ISM-1604"
    ],
    "provenance": {
      "disposition": "adapt",
      "upstream": {
        "repository": "https://github.com/kubescape/regolibrary",
        "ref": "01f57decc4a771facfb7166f02af986ccb560203",
        "control_id": "C-0013",
        "rule_name": "non-root-containers"
      },
      "rationale": "The local rule retains the upstream non-root intent while evaluating pod and container security contexts directly."
    }
  },
  "ruleLanguage": "Rego",
  "match": [
    {
      "apiGroups": [
        ""
      ],
      "apiVersions": [
        "v1"
      ],
