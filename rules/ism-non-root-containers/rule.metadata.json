      ]
    },
    {
      "apiGroups": [
        "apps"
      ],
      "apiVersions": [
        "v1"
      ],
      "resources": [
        "Deployment",
        "ReplicaSet",
        "DaemonSet",
        "StatefulSet"
      ]
    },
    {
      "apiGroups": [
        "batch"
      ],
      "apiVersions": [
        "*"
      ],
      "resources": [
        "Job",
        "CronJob"
      ]
    }
