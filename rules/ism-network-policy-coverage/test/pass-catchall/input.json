[
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "api",
      "namespace": "prod"
    },
    "spec": {
      "template": {
        "metadata": {
          "labels": {
            "app": "api"
          }
        },
        "spec": {
          "containers": [
            {
              "name": "api",
              "image": "registry.internal/app:v1"
            }
          ]
        }
      }
    }
  },
  {
    "apiVersion": "apps/v1",
    "kind": "Deployment",
    "metadata": {
      "name": "worker",
      "namespace": "prod"
    },
    "spec": {
      "template": {
        "metadata": {
          "labels": {
            "app": "worker"
          }
        },
        "spec": {
          "containers": [
            {
              "name": "worker",
              "image": "registry.internal/worker:v1"
            }
          ]
        }
      }
    }
  },
  {
    "apiVersion": "networking.k8s.io/v1",
    "kind": "NetworkPolicy",
    "metadata": {
      "name": "default-deny-ingress-egress",
      "namespace": "prod"
    },
    "spec": {
      "podSelector": {},
      "policyTypes": [
        "Ingress",
        "Egress"
      ],
      "ingress": [],
      "egress": []
    }
  }
]
