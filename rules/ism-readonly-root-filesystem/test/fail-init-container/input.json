[
  {
    "apiVersion": "v1",
    "kind": "Pod",
    "metadata": {
      "name": "mutable-init",
      "namespace": "prod"
    },
    "spec": {
      "initContainers": [
        {
          "name": "bootstrap",
          "image": "registry.internal/bootstrap:v1",
          "securityContext": {
            "readOnlyRootFilesystem": false
          }
        }
      ],
      "containers": [
        {
          "name": "api",
          "image": "registry.internal/app:v1",
          "securityContext": {
            "readOnlyRootFilesystem": true
          }
        }
      ]
    }
  }
]
